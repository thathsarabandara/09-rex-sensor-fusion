APP_NAME=rex-sensor-fusion
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=rex_sensor_fusion
MYSQL_USER=rex_user
MYSQL_PASSWORD=change-me

REDIS_URL=redis://localhost:6379/5

USER_JWT_SECRET_KEY=change-me
USER_JWT_ALGORITHM=HS256
USER_JWT_ISSUER=rex-auth-service
USER_JWT_AUDIENCE=rex-platform

INTERNAL_SERVICE_TOKEN=change-me
ROBOT_SERVICE_URL=http://rex-robot-service:8000
OWNERSHIP_CACHE_TTL_SECONDS=60

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=rex-sensor-fusion
KAFKA_CONSUMER_GROUP=rex-sensor-fusion-v1
KAFKA_INPUT_TOPIC=rex.telemetry.sensor-snapshot.v1
KAFKA_FUSED_STATE_TOPIC=rex.sensor-fusion.state.updated.v1

FUSION_WINDOW_MS=250
FUSION_OUTPUT_RATE_HZ=5

ULTRASONIC_MIN_DISTANCE_CM=2
ULTRASONIC_MAX_DISTANCE_CM=400
ULTRASONIC_MEDIAN_WINDOW=5
ULTRASONIC_EMA_ALPHA=0.35

OBSTACLE_LOW_DISTANCE_CM=100
OBSTACLE_MEDIUM_DISTANCE_CM=50
OBSTACLE_HIGH_DISTANCE_CM=25
OBSTACLE_CRITICAL_DISTANCE_CM=10

IMU_LOW_PASS_ALPHA=0.25
IMU_COMPLEMENTARY_ALPHA=0.98
UNSAFE_TILT_DEGREES=30
IMPACT_ACCELERATION_THRESHOLD=18

LINE_FILTER_WINDOW=5
LINE_DEBOUNCE_MS=50

STALL_MIN_SPEED=20
STALL_DETECTION_SECONDS=2

SENSOR_FRESH_SECONDS=1
SENSOR_AGING_SECONDS=3
SENSOR_STALE_SECONDS=5

PERSIST_FUSED_SAMPLES=true
FUSED_SAMPLE_INTERVAL_SECONDS=5
FUSION_EVENT_RETENTION_DAYS=90
FUSED_SAMPLE_RETENTION_DAYS=30

GHCR_IMAGE=ghcr.io/OWNER/09-rex-sensor-fusion
